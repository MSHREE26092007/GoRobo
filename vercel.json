{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "node scripts/build-catalog-data.mjs && pnpm build",
  "env": {
    "CATALOG_SNAPSHOT_API_URL": "https://amazecc-api-jrsp.onrender.com"
  },
  "headers": [
    {
      "source": "/data/catalog/index.:hash.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/catalog/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
